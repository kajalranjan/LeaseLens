# Copy to .streamlit/secrets.toml (git-ignored) and fill in.
# Without this file the app runs on data/mock_area_stats.csv.
[snowflake]
account   = "abc12345.us-east-1"   # from Snowsight: account menu -> "Connect a tool to Snowflake"
user      = "YOUR_USER"
password  = "YOUR_PASSWORD"
role      = "ACCOUNTADMIN"         # or a role with IMPORTED PRIVILEGES on the listing database
warehouse = "COMPUTE_WH"
database  = "<LISTING_DATABASE>"
schema    = "<LISTING_SCHEMA>"

# Trouble with password login (MFA)? Delete the password line and add:
# authenticator = "externalbrowser"   # opens a Snowflake login tab in your browser
